---
import { getCollection } from 'astro:content'
import Arrow from './Arrow.astro'

const projets = await getCollection('projets')
---

---

<div
  class="sticky top-0 left-0 w-full h-screen flex flex-col items-center justify-center -z-10 pb-20 md:pb-30"
>
  <div
    id="titreGraphiste"
    class="flex flex-col items-center justify-center transition-all duration-700 ease-out"
  >
    <p class="text-sm md:text-base mb-2">Web & print</p>
    <h1 class="text-6xl md:text-8xl leading-none">Graphiste</h1>
  </div>

  <div
    id="accroche"
    class="mt-12 flex transition-all duration-500 ease-in-out items-center justify-center w-50 md:w-120"
  >
    <p class="text-center text-xl">
      « <strong>J’aime</strong> essayer, tester et fabriquer. »
    </p>
  </div>
</div>

<div class="flex gap-4 fixed bottom-15 left-1/2 -translate-x-1/2 z-30">
  <a
    href="/RachelBastie_PortfolioNumerique2026.pdf"
    download="RachelBastie_PortfolioNumerique2026.pdf"
    target="_blank"
    class="flex items-center justify-center bg-red text-white border-2 border-[var(--color-white)] rounded-full px-6 py-2"
    ><strong>Portfolio</strong></a
  >
  <button
    onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
    class="flex items-center justify-center cursor-pointer bg-[var(--color-red)] w-12 md:w-12 border-2 border-[var(--color-white)] rounded-full"
    aria-label="Remonter en haut"
  >
    <div class="-rotate-90">
      <Arrow
        foreground="var(--color-white)"
        size="medium"
      />
    </div>
  </button>
</div>

<script>
  const titre = document.getElementById('titreGraphiste')
  const accroche = document.getElementById('accroche')

  const updateAnimation = () => {
    const scrollY = window.scrollY
    const width = window.innerWidth

    // On calcule un ratio entre 0 et 1
    // 0 = tout en haut | 1 = animation terminée
    const ratioAccroche = Math.min(Math.max(scrollY / 500, 0), 1)

    // Ce ratio reste à 0 tant que scrollY < 200
    // Si tu as mis pb-20 (80px), on réduit moveUp d'autant.
    const ratioTitre = Math.min(Math.max(scrollY / 400, 0), 1)

    // Configuration par rapport à la LARGEUR (width)
    let config = {
      moveUp: -200,
      scaleDivisor: 0.4,
    }

    if (width < 640) {
      config.moveUp = -250
      config.scaleDivisor = 0.2
    } else if (width >= 640 && width < 768) {
      config.moveUp = -260
      config.scaleDivisor = 0.2
    } else if (width >= 768 && width < 1024) {
      config.moveUp = -240
      config.scaleDivisor = 0.4
    } else if (width >= 1024 && width < 1440) {
      config.moveUp = -240
      config.scaleDivisor = 0.4
    } else if (width >= 1440) {
      config.moveUp = -250
      config.scaleDivisor = 0.4
    }

    if (titre) {
      const finalMove = ratioTitre * config.moveUp
      const finalScale = 1 - config.scaleDivisor * ratioTitre

      titre.style.transform = `translateY(${finalMove}px) scale(${finalScale})`
      titre.style.transformOrigin = 'top center'
    }

    if (accroche) {
      accroche.style.opacity = (1 - ratioAccroche * 1.5).toString()
      accroche.style.transform = `translateY(${ratioAccroche * 30}px)`
      accroche.style.pointerEvents = ratioAccroche >= 0.7 ? 'none' : 'auto'
    }
  }

  window.addEventListener('scroll', updateAnimation)
  // On lance une fois au chargement pour éviter un saut visuel si on refresh en milieu de page
  window.addEventListener('resize', updateAnimation)
  updateAnimation()
</script>
